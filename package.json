{
  "name": "cryptoos-monorepo",
  "version": "1.0.0",
  "private": true,
  "author": "Ilham Rizanto <ilhamgb11@gmail.com>",
  "license": "SEE LICENSE IN LICENSE.md",
  "description": "CryptoOS — Personal Crypto Investment & Trading Intelligence Operating System",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ilhamrizanto/CryptoOS.git"
  },
  "bugs": {
    "url": "https://github.com/ilhamrizanto/CryptoOS/issues"
  },
  "homepage": "https://github.com/ilhamrizanto/CryptoOS#readme",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently -k -p \"[{name}]\" -n \"API,WEB\" -c \"cyan.bold,magenta.bold\" \"npm run dev --workspace=backend\" \"npm run dev --workspace=frontend\"",
    "dev:backend": "npm run dev --workspace=backend",
    "dev:frontend": "npm run dev --workspace=frontend",
    "build": "npm run build --workspace=backend && npm run build --workspace=frontend",
    "lint": "npm run lint --workspaces",
    "seed:demo": "npm run seed:demo --workspace=backend"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "engines": {
    "node": ">=26.0.0",
    "npm": ">=11.0.0"
  }
}
