# =========================================================================
# CryptoOS Environment Configuration (.env)
# Multi-User Quantitative Trading & Investment Intelligence Operating System
# =========================================================================

# --- 1. Auth & Security ---
# --- 0. Public Portfolio Demo Mode (Safe & Self-Healing Showcase Sandbox) ---
# Set DEMO_MODE=True to enable public portfolio showcase mode.
# Features: 1-click role logins (Admin, Trader, Viewer), zero-leak sandbox mocking,
# and in-app lazy auto-reset every 1 hour without OS cron jobs.
DEMO_MODE=True
VITE_DEMO_MODE=True

JWT_SECRET=replace_with_a_secure_random_jwt_secret_at_least_32_chars
MASTER_PASSWORD_HASH=replace_with_bcrypt_hash_of_master_password

# --- Administrative Access Configuration (Configured via ENV) ---
# Primary Owner email address (full administrative & owner privileges)
OWNER_EMAIL=ilhamgb11@gmail.com
# Comma-separated list of additional Admin email addresses
ADMIN_EMAILS=ilhamgb11@gmail.com

# --- 2. Google OAuth Services (Multi-User Authentication) ---
# Primary Owner (ilhamgb11@gmail.com) is automatically seeded with OWNER role.
# Other users MUST be added to whitelist via the Admin tab in Settings.
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_PROJECT_ID=your_google_project_id
GOOGLE_CLIENT_EMAIL=your_service_account@project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY_ID=your_private_key_id
GOOGLE_APPLICATION_CREDENTIALS=./CryptoOS-GAService.json

# Frontend Vite Environment Variables (Google OAuth Client)
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
VITE_GOOGLE_PROJECT_ID=your_google_project_id

# --- 3. App & Server Config ---
NODE_ENV=development
PORT=3001
DATABASE_PATH=./data/cryptoos.db
CORS_ORIGIN=http://localhost:5173

# --- 4. Market Data APIs (Global Server Fallbacks - Optional) ---
# CryptoOS automatically pulls free public macro & forex data without keys:
# - FRED: Live St. Louis Fed BLS & BEA economic series via public CSV
# - Forex: Real-time USD/IDR currency rates via open.er-api.com
# - Crypto: Real-time prices via Binance Vision & CoinGecko public APIs
FRED_API_KEY=
ALPHA_VANTAGE_KEY=
EXCHANGERATE_API_KEY=

# --- 5. Exchange APIs (NOTE FOR MULTI-USER) ---
# In CryptoOS Multi-User architecture, each user manages their own Read-Only
# API keys non-custodially inside the web terminal (Settings > Exchange Credentials).
# Keys are stored client-side in the user's browser, NOT saved in the shared DB.
# The fields below are optional legacy single-user fallbacks:
BINANCE_API_KEY=
BINANCE_API_SECRET=
BYBIT_API_KEY=
BYBIT_API_SECRET=
OKX_API_KEY=
OKX_API_SECRET=
OKX_PASSPHRASE=
MEXC_API_KEY=
MEXC_API_SECRET=
INDODAX_API_KEY=
INDODAX_API_SECRET=
TOKOCRYPTO_API_KEY=
TOKOCRYPTO_API_SECRET=
TRIV_API_KEY=
TRIV_API_SECRET=
KUCOIN_API_KEY=
KUCOIN_API_SECRET=
KUCOIN_PASSPHRASE=
GATEIO_API_KEY=
GATEIO_API_SECRET=
BITGET_API_KEY=
BITGET_API_SECRET=
BITGET_PASSPHRASE=
